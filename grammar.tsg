// Ruby grammar for tree-sitter (native DSL).
// Translated from grammar.js.

let u = import("util.tsg")

let PREC = {
    COMMENT: -2,
    CURLY_BLOCK: 1,
    DO_BLOCK: -1,

    AND: -2,
    OR: -2,
    NOT: 5,
    DEFINED: 10,
    ALIAS: 11,
    ASSIGN: 15,
    RESCUE: 16,
    CONDITIONAL: 20,
    RANGE: 25,
    BOOLEAN_OR: 30,
    BOOLEAN_AND: 35,
    RELATIONAL: 40,
    COMPARISON: 45,
    BITWISE_OR: 50,
    BITWISE_AND: 55,
    CALL: 56,
    SHIFT: 60,
    ADDITIVE: 65,
    MULTIPLICATIVE: 70,
    UNARY_MINUS: 75,
    EXPONENTIAL: 80,
    COMPLEMENT: 85,
}

let IDENTIFIER_CHARS: rule_t = regexp(r#"[^\x00-\x1F\s:;`"'@$#.,|^&<=>+\-*/\\%?!~()\[\]{}]*"#)
let LOWER_ALPHA_CHAR: rule_t = regexp(r#"[^\x00-\x1F\sA-Z0-9:;`"'@$#.,|^&<=>+\-*/\\%?!~()\[\]{}]"#)
let ALPHA_CHAR: rule_t = regexp(r#"[^\x00-\x1F\s0-9:;`"'@$#.,|^&<=>+\-*/\\%?!~()\[\]{}]"#)

// Receiver shape used by both `call` and `command_call_with_block`. Inlined
// via macro so each call site produces its own subtree (matching the JS
// `const receiver = choice(...)` reuse pattern).
macro call_receiver() rule_t {
    choice(_call, field(method, choice(_variable, _function_identifier)))
}

// Receiver-with-arguments shape used by `call`.
macro call_receiver_args() rule_t {
    seq(
        choice(
            call_receiver(),
            prec_left(PREC.CALL, seq(
                field(receiver, _primary),
                field(operator, _call_operator),
            )),
        ),
        field(arguments, argument_list),
    )
}

grammar {
    language: "ruby",
    inline: [_arg_rhs, _call_operator],
    externals: [
        _line_break,
        _no_line_break,

        // Delimited literals
        simple_symbol,
        _string_start,
        _symbol_start,
        _subshell_start,
        _regex_start,
        _string_array_start,
        _symbol_array_start,
        _heredoc_body_start,
        string_content,
        heredoc_content,
        _string_end,
        heredoc_end,
        heredoc_beginning,

        // Tokens that require lookahead
        "/",
        _block_ampersand,
        _splat_star,
        _unary_minus,
        _unary_minus_num,
        _binary_minus,
        _binary_star,
        _singleton_class_left_angle_left_langle,
        hash_key_symbol,
        _identifier_suffix,
        _constant_suffix,
        _hash_splat_star_star,
        _binary_star_star,
        _element_reference_bracket,
        _short_interpolation,
    ],
    extras: [
        comment,
        heredoc_body,
        regexp(r"\s"),
        regexp(r"\\\r?\n"),
    ],
    word: identifier,
    supertypes: [
        _statement,
        _arg,
        _call_operator,
        _method_name,
        _expression,
        _variable,
        _primary,
        _simple_numeric,
        _lhs,
        _nonlocal_variable,
        _pattern_top_expr_body,
        _pattern_expr,
        _pattern_expr_basic,
        _pattern_primitive,
        _pattern_constant,
    ],
}

// ---------------------------------------------------------------------------
// Top level
// ---------------------------------------------------------------------------

rule program {
    seq(
        optional(_statements),
        optional(choice(seq(regexp(r"__END__"), uninterpreted))),
    )
}

rule uninterpreted { regexp(r"(.|\s)*") }

rule block_body { _statements }

rule _statements {
    choice(
        seq(
            repeat1(choice(
                seq(_statement, _terminator),
                empty_statement,
            )),
            optional(_statement),
        ),
        _statement,
    )
}

rule begin_block { seq("BEGIN", "{", optional(_statements), "}") }
rule end_block { seq("END", "{", optional(_statements), "}") }

rule _statement {
    choice(
        undef,
        alias,
        if_modifier,
        unless_modifier,
        while_modifier,
        until_modifier,
        rescue_modifier,
        begin_block,
        end_block,
        _expression,
    )
}

// ---------------------------------------------------------------------------
// Methods
// ---------------------------------------------------------------------------

rule method { seq("def", _method_rest) }

rule singleton_method {
    seq(
        "def",
        seq(
            choice(
                field(object, _variable),
                seq("(", field(object, _arg), ")"),
            ),
            choice(".", "::"),
        ),
        _method_rest,
    )
}

rule _method_rest {
    seq(
        field(name, _method_name),
        choice(
            _body_expr,
            seq(
                field(parameters, alias(parameters, method_parameters)),
                choice(
                    seq(optional(_terminator), optional(field(body, body_statement)), "end"),
                    _body_expr,
                ),
            ),
            seq(
                optional(field(parameters, alias(bare_parameters, method_parameters))),
                _terminator,
                optional(field(body, body_statement)),
                "end",
            ),
        ),
    )
}

rule rescue_modifier_arg {
    prec(PREC.RESCUE, seq(
        field(body, _arg),
        "rescue",
        field(handler, _arg),
    ))
}

rule rescue_modifier_expression {
    prec(PREC.RESCUE, seq(
        field(body, _expression),
        "rescue",
        field(handler, _arg),
    ))
}

rule _body_expr {
    seq(
        "=",
        field(body, choice(
            _arg,
            alias(rescue_modifier_arg, rescue_modifier),
        )),
    )
}

rule parameters { seq("(", u::commaSep(_formal_parameter), ")") }

rule bare_parameters {
    seq(_simple_formal_parameter, repeat(seq(",", _formal_parameter)))
}

rule block_parameters {
    seq(
        "|",
        seq(u::commaSep(_formal_parameter), optional(",")),
        optional(seq(";", u::sep1(field(locals, identifier), ","))),
        "|",
    )
}

rule _formal_parameter {
    choice(_simple_formal_parameter, alias(parameters, destructured_parameter))
}

rule _simple_formal_parameter {
    choice(
        identifier,
        splat_parameter,
        hash_splat_parameter,
        hash_splat_nil,
        forward_parameter,
        block_parameter,
        keyword_parameter,
        optional_parameter,
    )
}

rule forward_parameter { "..." }

rule splat_parameter {
    prec_right(-2, seq("*", field(name, optional(identifier))))
}

rule hash_splat_parameter { seq("**", field(name, optional(identifier))) }

rule hash_splat_nil { seq("**", "nil") }

rule block_parameter { seq("&", field(name, optional(identifier))) }

rule keyword_parameter {
    // PREC.BITWISE_OR + 1
    prec_right(51, seq(
        field(name, identifier),
        token_immediate(":"),
        field(value, optional(_arg)),
    ))
}

rule optional_parameter {
    // PREC.BITWISE_OR + 1
    prec(51, seq(
        field(name, identifier),
        "=",
        field(value, _arg),
    ))
}

// ---------------------------------------------------------------------------
// Classes / modules
// ---------------------------------------------------------------------------

rule class {
    seq(
        "class",
        field(name, choice(constant, scope_resolution)),
        choice(
            seq(field(superclass, superclass), _terminator),
            optional(_terminator),
        ),
        optional(field(body, body_statement)),
        "end",
    )
}

rule superclass { seq("<", _expression) }

rule singleton_class {
    seq(
        "class",
        alias(_singleton_class_left_angle_left_langle, "<<"),
        field(value, _arg),
        _terminator,
        optional(field(body, body_statement)),
        "end",
    )
}

rule module {
    seq(
        "module",
        field(name, choice(constant, scope_resolution)),
        optional(_terminator),
        optional(field(body, body_statement)),
        "end",
    )
}

// ---------------------------------------------------------------------------
// Control flow
// ---------------------------------------------------------------------------

rule return_command { prec_left(0, seq("return", alias(command_argument_list, argument_list))) }
rule yield_command { prec_left(0, seq("yield", alias(command_argument_list, argument_list))) }
rule break_command { prec_left(0, seq("break", alias(command_argument_list, argument_list))) }
rule next_command { prec_left(0, seq("next", alias(command_argument_list, argument_list))) }
rule r#return { prec_left(0, seq("return", optional(argument_list))) }
rule r#yield { prec_left(0, seq("yield", optional(argument_list))) }
rule r#break { prec_left(0, seq("break", optional(argument_list))) }
rule r#next { prec_left(0, seq("next", optional(argument_list))) }
rule redo { prec_left(0, seq("redo", optional(argument_list))) }
rule retry { prec_left(0, seq("retry", optional(argument_list))) }

rule if_modifier {
    prec(PREC.RESCUE, seq(field(body, _statement), "if", field(condition, _expression)))
}

rule unless_modifier {
    prec(PREC.RESCUE, seq(field(body, _statement), "unless", field(condition, _expression)))
}

rule while_modifier {
    prec(PREC.RESCUE, seq(field(body, _statement), "while", field(condition, _expression)))
}

rule until_modifier {
    prec(PREC.RESCUE, seq(field(body, _statement), "until", field(condition, _expression)))
}

rule rescue_modifier {
    prec(PREC.RESCUE, seq(field(body, _statement), "rescue", field(handler, _expression)))
}

rule r#while {
    seq("while", field(condition, _statement), field(body, do))
}

rule until {
    seq("until", field(condition, _statement), field(body, do))
}

rule r#for {
    seq(
        "for",
        field(pattern, choice(_lhs, left_assignment_list)),
        field(value, r#in),
        field(body, do),
    )
}

rule r#in { seq("in", _arg) }

rule do {
    seq(
        choice("do", _terminator),
        optional(_statements),
        "end",
    )
}

rule case {
    seq(
        "case",
        optional(seq(optional(_line_break), field(value, _statement))),
        optional(_terminator),
        repeat(when),
        optional(else),
        "end",
    )
}

rule case_match {
    seq(
        "case",
        seq(optional(_line_break), field(value, _statement)),
        optional(_terminator),
        repeat1(field(clauses, in_clause)),
        optional(field(else, else)),
        "end",
    )
}

rule when {
    seq(
        "when",
        u::commaSep1(field(pattern, pattern)),
        choice(_terminator, field(body, then)),
    )
}

rule in_clause {
    seq(
        "in",
        field(pattern, _pattern_top_expr_body),
        field(guard, optional(_guard)),
        choice(_terminator, field(body, then)),
    )
}

rule pattern { choice(_arg, splat_argument) }

rule _guard { choice(if_guard, unless_guard) }

rule if_guard { seq("if", field(condition, _expression)) }
rule unless_guard { seq("unless", field(condition, _expression)) }

// ---------------------------------------------------------------------------
// Patterns
// ---------------------------------------------------------------------------

rule _pattern_top_expr_body {
    prec(-1, choice(
        _pattern_expr,
        alias(_array_pattern_n, array_pattern),
        alias(_find_pattern_body, find_pattern),
        alias(_hash_pattern_body, hash_pattern),
    ))
}

rule _array_pattern_n {
    prec_right(0, choice(
        seq(_pattern_expr, alias(",", splat_parameter)),
        seq(_pattern_expr, ",", choice(_pattern_expr, _array_pattern_n)),
        seq(splat_parameter, repeat(seq(",", _pattern_expr))),
    ))
}

rule _pattern_expr {
    choice(as_pattern, _pattern_expr_alt)
}

rule as_pattern {
    seq(field(value, _pattern_expr), "=>", field(name, identifier))
}

rule _pattern_expr_alt {
    choice(alternative_pattern, _pattern_expr_basic)
}

rule alternative_pattern {
    seq(
        field(alternatives, _pattern_expr_basic),
        repeat1(seq("|", field(alternatives, _pattern_expr_basic))),
    )
}

rule _array_pattern_body {
    choice(_pattern_expr, _array_pattern_n)
}

rule array_pattern {
    prec_right(-1, choice(
        seq("[", optional(_array_pattern_body), "]"),
        seq(field(class, _pattern_constant), token_immediate("["), optional(_array_pattern_body), "]"),
        seq(field(class, _pattern_constant), token_immediate("("), optional(_array_pattern_body), ")"),
    ))
}

rule _find_pattern_body {
    seq(splat_parameter, repeat1(seq(",", _pattern_expr)), ",", splat_parameter)
}

rule find_pattern {
    choice(
        seq("[", _find_pattern_body, "]"),
        seq(field(class, _pattern_constant), token_immediate("["), _find_pattern_body, "]"),
        seq(field(class, _pattern_constant), token_immediate("("), _find_pattern_body, ")"),
    )
}

rule _hash_pattern_body {
    prec_right(0, choice(
        seq(u::commaSep1(keyword_pattern), optional(",")),
        seq(u::commaSep1(keyword_pattern), ",", _hash_pattern_any_rest),
        _hash_pattern_any_rest,
    ))
}

rule keyword_pattern {
    prec_right(-1, seq(
        field(key, choice(
            alias(identifier, hash_key_symbol),
            alias(constant, hash_key_symbol),
            alias(identifier_suffix, hash_key_symbol),
            alias(constant_suffix, hash_key_symbol),
            string,
        )),
        token_immediate(":"),
        optional(field(value, _pattern_expr)),
    ))
}

rule _hash_pattern_any_rest { choice(hash_splat_parameter, hash_splat_nil) }

rule hash_pattern {
    prec_right(-1, choice(
        seq("{", optional(_hash_pattern_body), "}"),
        seq(field(class, _pattern_constant), token_immediate("["), _hash_pattern_body, "]"),
        seq(field(class, _pattern_constant), token_immediate("("), _hash_pattern_body, ")"),
    ))
}

rule _pattern_expr_basic {
    prec_right(-1, choice(
        _pattern_value,
        identifier,
        array_pattern,
        find_pattern,
        hash_pattern,
        parenthesized_pattern,
    ))
}

rule parenthesized_pattern { seq("(", _pattern_expr, ")") }

rule _pattern_value {
    prec_right(-1, choice(
        _pattern_primitive,
        alias(_pattern_range, range),
        variable_reference_pattern,
        expression_reference_pattern,
        _pattern_constant,
    ))
}

rule _pattern_range {
    choice(
        seq(
            field(begin, _pattern_primitive),
            field(operator, choice("..", "...")),
            field(end, _pattern_primitive),
        ),
        seq(
            field(operator, choice("..", "...")),
            field(end, _pattern_primitive),
        ),
        seq(
            field(begin, _pattern_primitive),
            field(operator, choice("..", "...")),
        ),
    )
}

rule _pattern_primitive { choice(_pattern_literal, _pattern_lambda) }

rule _pattern_lambda { prec_right(-1, lambda) }

rule _pattern_literal {
    prec_right(-1, choice(
        _literal,
        string,
        subshell,
        heredoc_beginning,
        regex,
        string_array,
        symbol_array,
        _keyword_variable,
    ))
}

rule _keyword_variable {
    prec_right(-1, choice(nil, self, true, false, line, file, encoding))
}

rule line { "__LINE__" }
rule file { "__FILE__" }
rule encoding { "__ENCODING__" }

rule variable_reference_pattern {
    seq("^", field(name, choice(identifier, _nonlocal_variable)))
}

rule expression_reference_pattern {
    seq("^", "(", field(value, _expression), ")")
}

rule _pattern_constant {
    prec_right(-1, choice(
        constant,
        alias(_pattern_constant_resolution, scope_resolution),
    ))
}

rule _pattern_constant_resolution {
    seq(
        optional(field(scope, _pattern_constant)),
        "::",
        field(name, constant),
    )
}

// ---------------------------------------------------------------------------
// If / unless / case
// ---------------------------------------------------------------------------

rule r#if {
    seq(
        "if",
        field(condition, _statement),
        choice(_terminator, field(consequence, then)),
        field(alternative, optional(choice(else, elsif))),
        "end",
    )
}

rule unless {
    seq(
        "unless",
        field(condition, _statement),
        choice(_terminator, field(consequence, then)),
        field(alternative, optional(choice(else, elsif))),
        "end",
    )
}

rule elsif {
    seq(
        "elsif",
        field(condition, _statement),
        choice(_terminator, field(consequence, then)),
        field(alternative, optional(choice(else, elsif))),
    )
}

rule r#else {
    seq("else", optional(_terminator), optional(_statements))
}

rule then {
    choice(
        seq(_terminator, _statements),
        seq(optional(_terminator), "then", optional(_statements)),
    )
}

rule begin {
    seq("begin", optional(_terminator), optional(_body_statement), "end")
}

rule ensure { seq("ensure", optional(_statements)) }

rule rescue {
    seq(
        "rescue",
        field(exceptions, optional(exceptions)),
        field(variable, optional(exception_variable)),
        choice(_terminator, field(body, then)),
    )
}

rule exceptions { u::commaSep1(choice(_arg, splat_argument)) }

rule exception_variable { seq("=>", _lhs) }

rule body_statement { _body_statement }

rule _body_statement {
    choice(
        seq(_statements, repeat(choice(rescue, else, ensure))),
        seq(optional(_statements), repeat1(choice(rescue, else, ensure))),
    )
}

// ---------------------------------------------------------------------------
// Expressions / arguments
// ---------------------------------------------------------------------------

// Method calls without parentheses (aka "command calls") are only allowed
// in certain positions, so a lot of rules have a normal variant and a
// "command" variant. See grammar.js for the full explanation.
rule _expression {
    choice(
        alias(command_binary, binary),
        alias(command_unary, unary),
        alias(command_assignment, assignment),
        alias(command_operator_assignment, operator_assignment),
        alias(command_call, call),
        alias(command_call_with_block, call),
        prec_left(0, alias(_chained_command_call, call)),
        alias(return_command, return),
        alias(yield_command, yield),
        alias(break_command, break),
        alias(next_command, next),
        match_pattern,
        test_pattern,
        _arg,
    )
}

rule match_pattern {
    prec(100, seq(field(value, _arg), "=>", field(pattern, _pattern_top_expr_body)))
}

rule test_pattern {
    prec(100, seq(field(value, _arg), "in", field(pattern, _pattern_top_expr_body)))
}

rule _arg {
    choice(
        alias(_unary_minus_pow, unary),
        _primary,
        assignment,
        operator_assignment,
        conditional,
        range,
        binary,
        unary,
    )
}

rule _unary_minus_pow {
    seq(
        field(operator, alias(_unary_minus_num, "-")),
        field(operand, alias(_pow, binary)),
    )
}

rule _pow {
    prec_right(PREC.EXPONENTIAL, seq(
        field(left, _simple_numeric),
        field(operator, alias(_binary_star_star, "**")),
        field(right, _arg),
    ))
}

rule _primary {
    choice(
        parenthesized_statements,
        _lhs,
        alias(_function_identifier_call, call),
        call,
        array,
        string_array,
        symbol_array,
        hash,
        subshell,
        _literal,
        string,
        character,
        chained_string,
        regex,
        lambda,
        method,
        singleton_method,
        class,
        singleton_class,
        module,
        begin,
        while,
        until,
        if,
        unless,
        for,
        case,
        case_match,
        return,
        yield,
        break,
        next,
        redo,
        retry,
        alias(parenthesized_unary, unary),
        heredoc_beginning,
    )
}

rule parenthesized_statements { seq("(", optional(_statements), ")") }

rule element_reference {
    prec_left(1, seq(
        field(object, _primary),
        alias(_element_reference_bracket, "["),
        optional(_argument_list_with_trailing_comma),
        "]",
        optional(field(block, choice(block, do_block))),
    ))
}

rule scope_resolution {
    // PREC.CALL + 1
    prec_left(57, seq(
        choice(
            "::",
            seq(field(scope, _primary), token_immediate("::")),
        ),
        field(name, constant),
    ))
}

rule _call_operator { choice(".", "&.", token_immediate("::")) }

rule _call {
    prec_left(PREC.CALL, seq(
        field(receiver, _primary),
        field(operator, _call_operator),
        field(method, choice(identifier, operator, constant, _function_identifier)),
    ))
}

rule command_call {
    seq(
        choice(
            _call,
            _chained_command_call,
            field(method, choice(_variable, _function_identifier)),
        ),
        field(arguments, alias(command_argument_list, argument_list)),
    )
}

rule command_call_with_block {
    choice(
        seq(
            call_receiver(),
            prec(PREC.CURLY_BLOCK, seq(
                field(arguments, alias(command_argument_list, argument_list)),
                field(block, block),
            )),
        ),
        seq(
            call_receiver(),
            prec(PREC.DO_BLOCK, seq(
                field(arguments, alias(command_argument_list, argument_list)),
                field(block, do_block),
            )),
        ),
    )
}

rule _chained_command_call {
    seq(
        field(receiver, alias(command_call_with_block, call)),
        field(operator, _call_operator),
        field(method, choice(identifier, _function_identifier, operator, constant)),
    )
}

rule call {
    choice(
        call_receiver_args(),
        prec(PREC.CURLY_BLOCK, seq(call_receiver_args(), field(block, block))),
        prec(PREC.DO_BLOCK, seq(call_receiver_args(), field(block, do_block))),
        prec(PREC.CURLY_BLOCK, seq(call_receiver(), field(block, block))),
        prec(PREC.DO_BLOCK, seq(call_receiver(), field(block, do_block))),
    )
}

rule command_argument_list { prec_right(0, u::commaSep1(_argument)) }

rule argument_list {
    prec_right(0, seq(
        token_immediate("("),
        optional(_argument_list_with_trailing_comma),
        ")",
    ))
}

rule _argument_list_with_trailing_comma {
    prec_right(0, seq(u::commaSep1(_argument), optional(",")))
}

rule _argument {
    prec_left(0, choice(
        _expression,
        splat_argument,
        hash_splat_argument,
        forward_argument,
        block_argument,
        pair,
    ))
}

rule forward_argument { "..." }
rule splat_argument { prec_right(0, seq(alias(_splat_star, "*"), optional(_arg))) }
rule hash_splat_argument { prec_right(0, seq(alias(_hash_splat_star_star, "**"), optional(_arg))) }
rule block_argument { prec_right(0, seq(alias(_block_ampersand, "&"), optional(_arg))) }

rule do_block {
    seq(
        "do",
        optional(_terminator),
        optional(seq(
            field(parameters, block_parameters),
            optional(_terminator),
        )),
        optional(field(body, body_statement)),
        "end",
    )
}

rule block {
    prec(PREC.CURLY_BLOCK, seq(
        "{",
        field(parameters, optional(block_parameters)),
        optional(field(body, block_body)),
        "}",
    ))
}

// ---------------------------------------------------------------------------
// Assignment / binary / unary
// ---------------------------------------------------------------------------

rule _arg_rhs { choice(_arg, alias(rescue_modifier_arg, rescue_modifier)) }

rule assignment {
    prec_right(PREC.ASSIGN, choice(
        seq(
            field(left, choice(_lhs, left_assignment_list)),
            "=",
            field(right, choice(
                _arg_rhs,
                splat_argument,
                right_assignment_list,
            )),
        ),
    ))
}

rule command_assignment {
    prec_right(PREC.ASSIGN, seq(
        field(left, choice(_lhs, left_assignment_list)),
        "=",
        field(right, choice(_expression, alias(rescue_modifier_expression, rescue_modifier))),
    ))
}

rule operator_assignment {
    prec_right(PREC.ASSIGN, seq(
        field(left, _lhs),
        field(operator, choice("+=", "-=", "*=", "**=", "/=", "||=", "|=", "&&=", "&=", "%=", ">>=", "<<=", "^=")),
        field(right, _arg_rhs),
    ))
}

rule command_operator_assignment {
    prec_right(PREC.ASSIGN, seq(
        field(left, _lhs),
        field(operator, choice("+=", "-=", "*=", "**=", "/=", "||=", "|=", "&&=", "&=", "%=", ">>=", "<<=", "^=")),
        field(right, choice(_expression, alias(rescue_modifier_expression, rescue_modifier))),
    ))
}

rule conditional {
    prec_right(PREC.CONDITIONAL, seq(
        field(condition, _arg),
        "?",
        field(consequence, _arg),
        ":",
        field(alternative, _arg),
    ))
}

rule range {
    prec_right(PREC.RANGE, choice(
        seq(field(begin, _arg), field(operator, choice("..", "...")), field(end, _arg)),
        seq(field(operator, choice("..", "...")), field(end, _arg)),
        seq(field(begin, _arg), field(operator, choice("..", "..."))),
    ))
}

rule binary {
    choice(
        for (op: rule_t, p: int_t) in [
            ("and", PREC.AND),
            ("or", PREC.OR),
            ("||", PREC.BOOLEAN_OR),
            ("&&", PREC.BOOLEAN_AND),
            (choice("<<", ">>"), PREC.SHIFT),
            (choice("<", "<=", ">", ">="), PREC.COMPARISON),
            ("&", PREC.BITWISE_AND),
            (choice("^", "|"), PREC.BITWISE_OR),
            (choice("+", alias(_binary_minus, "-")), PREC.ADDITIVE),
            (choice("/", "%", alias(_binary_star, "*")), PREC.MULTIPLICATIVE),
        ] {
            prec_left(p, seq(
                field(left, _arg),
                field(operator, op),
                field(right, _arg),
            ))
        },
        for (op: rule_t, p: int_t) in [
            (choice("==", "!=", "===", "<=>", "=~", "!~"), PREC.RELATIONAL),
            (alias(_binary_star_star, "**"), PREC.EXPONENTIAL),
        ] {
            prec_right(p, seq(
                field(left, _arg),
                field(operator, op),
                field(right, _arg),
            ))
        },
    )
}

rule command_binary {
    prec_left(0, seq(
        field(left, _expression),
        field(operator, choice("or", "and")),
        field(right, _expression),
    ))
}

rule unary {
    choice(
        prec(PREC.DEFINED, seq(field(operator, "defined?"), field(operand, _arg))),
        for (op: rule_t, p: int_t) in [
            ("not", PREC.NOT),
            (choice(alias(_unary_minus, "-"), alias(_binary_minus, "-"), "+"), PREC.UNARY_MINUS),
            (choice("!", "~"), PREC.COMPLEMENT),
        ] {
            prec_right(p, seq(field(operator, op), field(operand, _arg)))
        },
    )
}

rule command_unary {
    choice(
        prec(PREC.DEFINED, seq(field(operator, "defined?"), field(operand, _expression))),
        for (op: rule_t, p: int_t) in [
            ("not", PREC.NOT),
            (choice(alias(_unary_minus, "-"), "+"), PREC.UNARY_MINUS),
            (choice("!", "~"), PREC.COMPLEMENT),
        ] {
            prec_right(p, seq(field(operator, op), field(operand, _expression)))
        },
    )
}

rule parenthesized_unary {
    prec(PREC.CALL, seq(
        field(operator, choice("defined?", "not")),
        field(operand, parenthesized_statements),
    ))
}

rule unary_literal {
    prec_right(PREC.UNARY_MINUS, seq(
        field(operator, choice(alias(_unary_minus_num, "-"), "+")),
        field(operand, _simple_numeric),
    ))
}

// ---------------------------------------------------------------------------
// Literals
// ---------------------------------------------------------------------------

rule _literal { choice(simple_symbol, delimited_symbol, _numeric) }

rule _numeric { choice(_simple_numeric, alias(unary_literal, unary)) }

rule _simple_numeric { choice(integer, float, complex, rational) }

rule right_assignment_list {
    prec(-1, u::commaSep1(choice(_arg, splat_argument)))
}

rule left_assignment_list { _mlhs }

rule _mlhs {
    prec_left(-1, seq(
        u::commaSep1(choice(_lhs, rest_assignment, destructured_left_assignment)),
        optional(","),
    ))
}

rule destructured_left_assignment { prec(-1, seq("(", _mlhs, ")")) }

rule rest_assignment { prec(-1, seq("*", optional(_lhs))) }

rule _function_identifier {
    choice(alias(identifier_suffix, identifier), alias(constant_suffix, constant))
}

rule _function_identifier_call {
    prec_left(0, field(method, _function_identifier))
}

rule _lhs {
    prec_left(0, choice(
        _variable,
        true,
        false,
        nil,
        scope_resolution,
        element_reference,
        alias(_call, call),
    ))
}

rule _variable {
    prec_right(0, choice(
        self,
        super,
        _nonlocal_variable,
        identifier,
        constant,
    ))
}

rule operator {
    choice(
        "..", "|", "^", "&", "<=>", "==", "===", "=~", ">", ">=", "<", "<=", "+", "!=",
        "-", "*", "/", "%", "!", "!~", "**", "<<", ">>", "~", "+@", "-@", "~@", "[]", "[]=", "`",
    )
}

rule _method_name {
    choice(
        identifier,
        _function_identifier,
        constant,
        setter,
        simple_symbol,
        delimited_symbol,
        operator,
        _nonlocal_variable,
    )
}

rule _nonlocal_variable {
    choice(instance_variable, class_variable, global_variable)
}

rule setter { seq(field(name, identifier), token_immediate("=")) }

rule undef { seq("undef", u::commaSep1(_method_name)) }
rule alias {
    seq("alias", field(name, _method_name), field(alias, _method_name))
}

rule comment {
    token(prec(PREC.COMMENT, choice(
        seq("#", regexp(r".*")),
        seq(
            regexp(r"=begin.*\r?\n"),
            repeat(choice(
                regexp(r"[^=]"),
                regexp(r"=[^e]"),
                regexp(r"=e[^n]"),
                regexp(r"=en[^d]"),
            )),
            regexp(r"[\s*]*=end.*"),
        ),
    )))
}

rule integer {
    regexp(r"0[bB][01](_?[01])*|0[oO]?[0-7](_?[0-7])*|(0[dD])?\d(_?\d)*|0[xX][0-9a-fA-F](_?[0-9a-fA-F])*")
}
rule _int_or_float { choice(integer, float) }
rule float {
    regexp(r"\d(_?\d)*(\.\d)?(_?\d)*([eE][\+-]?\d(_?\d)*)?")
}
rule complex {
    choice(
        seq(_int_or_float, token_immediate("i")),
        seq(alias(_int_or_float, rational), token_immediate("ri")),
    )
}
rule rational { seq(_int_or_float, token_immediate("r")) }

rule super { "super" }
rule self { "self" }
rule true { "true" }
rule false { "false" }
rule nil { "nil" }

rule constant { token(seq(regexp(r"[A-Z]"), IDENTIFIER_CHARS)) }
rule constant_suffix {
    choice(token(seq(regexp(r"[A-Z]"), IDENTIFIER_CHARS, regexp(r"[?]"))), _constant_suffix)
}
rule identifier { token(seq(LOWER_ALPHA_CHAR, IDENTIFIER_CHARS)) }
rule identifier_suffix {
    choice(token(seq(LOWER_ALPHA_CHAR, IDENTIFIER_CHARS, regexp(r"[?]"))), _identifier_suffix)
}
rule instance_variable { token(seq("@", ALPHA_CHAR, IDENTIFIER_CHARS)) }
rule class_variable { token(seq("@@", ALPHA_CHAR, IDENTIFIER_CHARS)) }

rule global_variable {
    regexp(r#"\$(-[a-zA-Z0-9_]|[!@&`'+~=/\\,;.<>*$?:"]|[0-9]+|[a-zA-Z_][a-zA-Z0-9_]*)"#)
}

rule chained_string { seq(string, repeat1(string)) }

rule character {
    regexp(r"\?(\\\S(\{[0-9A-Fa-f]*\}|[0-9A-Fa-f]*|-\S([MC]-\S)?)?|\S)")
}

rule interpolation {
    choice(
        seq("#{", optional(_statements), "}"),
        seq(_short_interpolation, _nonlocal_variable),
    )
}

rule string {
    seq(
        alias(_string_start, "\""),
        optional(_literal_contents),
        alias(_string_end, "\""),
    )
}

rule subshell {
    seq(
        alias(_subshell_start, "`"),
        optional(_literal_contents),
        alias(_string_end, "`"),
    )
}

rule string_array {
    seq(
        alias(_string_array_start, "%w("),
        optional(regexp(r"\s+")),
        u::sep(alias(_literal_contents, bare_string), regexp(r"\s+")),
        optional(regexp(r"\s+")),
        alias(_string_end, ")"),
    )
}

rule symbol_array {
    seq(
        alias(_symbol_array_start, "%i("),
        optional(regexp(r"\s+")),
        u::sep(alias(_literal_contents, bare_symbol), regexp(r"\s+")),
        optional(regexp(r"\s+")),
        alias(_string_end, ")"),
    )
}

rule delimited_symbol {
    seq(
        alias(_symbol_start, ":\""),
        optional(_literal_contents),
        alias(_string_end, "\""),
    )
}

rule regex {
    seq(
        alias(_regex_start, "/"),
        optional(_literal_contents),
        alias(_string_end, "/"),
    )
}

rule heredoc_body {
    seq(
        _heredoc_body_start,
        repeat(choice(heredoc_content, interpolation, escape_sequence)),
        heredoc_end,
    )
}

rule _literal_contents {
    repeat1(choice(string_content, interpolation, escape_sequence))
}

// https://ruby-doc.org/core-2.5.0/doc/syntax/literals_rdoc.html#label-Strings
rule escape_sequence {
    token(seq(
        "\\",
        choice(
            regexp(r"[^ux0-7]"),
            regexp(r"x[0-9a-fA-F]{1,2}"),
            regexp(r"[0-7]{1,3}"),
            regexp(r"u[0-9a-fA-F]{4}"),
            regexp(r"u\{[0-9a-fA-F ]+\}"),
        ),
    ))
}

rule array {
    seq("[", optional(_argument_list_with_trailing_comma), "]")
}

rule hash {
    seq(
        "{",
        optional(seq(
            u::commaSep1(choice(pair, hash_splat_argument)),
            optional(","),
        )),
        "}",
    )
}

rule pair {
    prec_right(0, choice(
        seq(field(key, _arg), "=>", field(value, _arg)),
        seq(
            field(key, choice(string)),
            token_immediate(":"),
            field(value, _arg),
        ),
        seq(
            field(key, choice(
                hash_key_symbol,
                alias(identifier, hash_key_symbol),
                alias(constant, hash_key_symbol),
                alias(identifier_suffix, hash_key_symbol),
                alias(constant_suffix, hash_key_symbol),
            )),
            token_immediate(":"),
            choice(
                field(value, optional(_arg)),
                // This alternative never matches because '_no_line_break' tokens
                // are never produced; it hints to the scanner not to emit a
                // line-break terminator at this point.
                _no_line_break,
            ),
        ),
    ))
}

rule lambda {
    seq(
        "->",
        field(parameters, optional(choice(
            alias(parameters, lambda_parameters),
            alias(bare_parameters, lambda_parameters),
        ))),
        field(body, choice(block, do_block)),
    )
}

rule empty_statement { prec(-1, ";") }

rule _terminator { choice(_line_break, ";") }
